# Copy these values from Firebase Console → Project settings → Your apps → Web app.
# Use them with flutter run/build as --dart-define entries or store them as GitHub Actions secrets.
FIREBASE_API_KEY=your-api-key
FIREBASE_APP_ID=your-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_WEB_VAPID_KEY=optional-web-push-vapid-key
